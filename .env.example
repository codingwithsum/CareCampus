# ==============================================
# CareCampus - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit the .env file to Git!
# ==============================================

# Firebase Web Configuration
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_WEB_APP_ID=your_firebase_web_app_id_here
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_WEB_PROJECT_ID=your_firebase_project_id_here
FIREBASE_WEB_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your_project.firebasestorage.app

# Firebase Android Configuration
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here
FIREBASE_ANDROID_APP_ID=your_firebase_android_app_id_here
FIREBASE_ANDROID_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_ANDROID_PROJECT_ID=your_firebase_project_id_here
FIREBASE_ANDROID_STORAGE_BUCKET=your_project.firebasestorage.app

# Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (free tier: gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
